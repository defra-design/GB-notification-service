{
  "scripts": {
    "dev": "govuk-prototype-kit dev",
    "serve": "govuk-prototype-kit serve",
    "start": "govuk-prototype-kit start",
    "test:prototype": "playwright test --config journey-demo/playwright.config.js",
    "test:prototype:report": "playwright show-report journey-demo/playwright-report",
    "commodities:baseline": "node scripts/build-commodities/dump-baseline.js",
    "check:commodities": "node scripts/build-commodities/check.js",
    "test:commodity-search": "playwright test --config journey-demo/playwright.config.js commodity-search",
    "screenshots:commodity-checks": "playwright test --config journey-demo/playwright.screens.config.js",
    "test:commodity-search:record":"RECORD_BASELINE=1 playwright test --config journey-demo/playwright.config.js commodity-search"
  },
  "dependencies": {
    "@govuk-prototype-kit/common-templates": "3.0.0",
    "@ministryofjustice/frontend": "^9.0.0",
    "govuk-frontend": "6.3.0",
    "govuk-prototype-kit": "13.20.2",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
